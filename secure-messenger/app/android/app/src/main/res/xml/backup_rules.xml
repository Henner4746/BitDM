<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 und aelter (API <= 30).

  Greift nur, falls allowBackup jemals wieder aktiviert wuerde — dann bleibt
  wenigstens hier alles ausgeschlossen. Siehe data_extraction_rules.xml fuer
  die Begruendung.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
