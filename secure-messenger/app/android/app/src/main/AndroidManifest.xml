<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Zum Verbinden mit dem Relay. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Zum Einlesen einer Adresse per QR-Code. Wird erst abgefragt, wenn
         jemand den Scan-Knopf drueckt, nie beim Start. -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Fuer den Sicherheitsschluessel per NFC.
         Das nfc_manager-Plugin deklariert sie NICHT selbst — ohne diese Zeile
         schlaegt das Auslesen zur Laufzeit fehl, und zwar erst auf dem Geraet.
         Nachgeprueft im Manifest des Plugins, nicht angenommen.
         NFC ist eine "normale" Berechtigung: sie wird bei der Installation
         erteilt und dem Nutzer nie als Abfrage gezeigt. -->
    <uses-permission android:name="android.permission.NFC"/>

    <!-- required=false, damit die App auch auf Telefonen ohne NFC-Chip
         installierbar bleibt. Ohne das schliesst der Play Store sie dort aus. -->
    <uses-feature android:name="android.hardware.nfc" android:required="false"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- ══════════════════════════════════════════════════════════════════
         AUSDRUECKLICH ENTFERNT, was die Kamera-Bibliothek mitbringt.

         Das camera-Plugin traegt in sein Manifest RECORD_AUDIO und die
         Speicher-Berechtigungen ein, weil es auch Videos aufnehmen kann. BitDM
         nimmt nichts auf: der CameraController wird mit enableAudio: false
         erzeugt und liest nur Einzelbilder.

         Ohne diese Zeilen staende im Play Store bei einer App, die mit
         Vertraulichkeit wirbt, "kann Audio aufnehmen" und "kann auf Dateien
         zugreifen". Das zerstoert mehr Vertrauen, als jede Verschluesselung
         aufbauen kann — und es waere schlicht nicht wahr.

         Geprueft nach jedem Bauen mit:
             aapt2 dump permissions app-release.apk
         ══════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove"/>

    <!-- ACCESS_NETWORK_STATE bleibt: sie ist eine "normale" Berechtigung, die
         der Nutzer nie zu Gesicht bekommt, und sie wird gebraucht, um beim
         Wiederverbinden nicht ins Leere zu funken, wenn ohnehin kein Netz da
         ist. -->

    <application
        android:label="BitDM"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
