<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Zum Verbinden mit dem Relay. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Zum Einlesen einer Adresse per QR-Code. Wird erst abgefragt, wenn
         jemand den Scan-Knopf drueckt, nie beim Start. -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Fuer den Sicherheitsschluessel per NFC.
         Das nfc_manager-Plugin deklariert sie NICHT selbst — ohne diese Zeile
         schlaegt das Auslesen zur Laufzeit fehl, und zwar erst auf dem Geraet.
         Nachgeprueft im Manifest des Plugins, nicht angenommen.
         NFC ist eine "normale" Berechtigung: sie wird bei der Installation
         erteilt und dem Nutzer nie als Abfrage gezeigt. -->
    <uses-permission android:name="android.permission.NFC"/>

    <!-- required=false, damit die App auch auf Telefonen ohne NFC-Chip
         installierbar bleibt. Ohne das schliesst der Play Store sie dort aus. -->
    <uses-feature android:name="android.hardware.nfc" android:required="false"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- Die Kamera-Bibliothek traegt "camera.any" OHNE required="false" ein.
         Beim Zusammenfuehren der Manifeste bleibt es dann erforderlich, und
         der Play Store blendet die App auf jedem Geraet ohne Kamera aus —
         wegen einer Funktion, die hier nur zum QR-Scannen dient und die es
         auch ohne gibt (Adresse einfuegen).

         tools:replace ueberschreibt den Eintrag der Bibliothek. Ohne diese
         Zeile faellt es erst auf, wenn jemand die App im Store nicht findet
         und niemand weiss, warum. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false"
        tools:replace="android:required"/>

    <!-- Ein Sicherheitsschluessel laesst sich auch EINSTECKEN. Dafuer braucht
         es keine Berechtigung: den Zugriff auf ein einzelnes USB-Geraet gibt
         der Nutzer im Systemdialog frei, und nur fuer dieses eine Geraet.
         Diese Angabe sagt nur, dass die App USB-Geraete bedienen KANN.

         required=false, weil viele Telefone keinen USB-Host koennen — dort
         bleibt der Weg ueber NFC. Ohne das schliesst der Play Store sie
         aus. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false"/>

    <!-- Der Vordergrunddienst, der den Prozess am Leben haelt, wenn im
         Hintergrund empfangen werden soll.

         AB ANDROID 14 reicht die allgemeine Berechtigung nicht mehr: jeder
         Dienst muss einen TYP nennen, und fuer jeden Typ gibt es eine eigene
         Berechtigung. Ohne die zweite Zeile stuerzt die App beim Starten des
         Dienstes ab — und zwar erst auf Android 14, nicht darunter.

         Der Nutzer entscheidet, ob es den Dienst ueberhaupt gibt: ab Werk ist
         der Hintergrundempfang AUS. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>

    <!-- WAKE_LOCK kommt ueber das UnifiedPush-Paket herein, nicht von hier.
         Hier steht sie trotzdem, weil in dieser Datei jede Berechtigung einen
         Grund haben soll — auch die, die ein Paket mitbringt.

         WOFUER: kommt ein Anstoss an, waehrend das Telefon schlaeft, muss es
         wach bleiben, bis die App die Nachricht beim Relay abgeholt hat. Ohne
         sie schliefe es mitten im Abholen wieder ein.

         Sie erlaubt NICHT, das Telefon aufzuwecken oder wach zu halten,
         solange nichts passiert — nur, ein begonnenes Stueck Arbeit zu Ende
         zu bringen. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Ab Android 11 sieht eine App die anderen nicht mehr, ohne zu sagen,
         WELCHE sie sucht. Ohne diesen Block scheitern die Knoepfe in der
         Anleitung zum Anstoss-Verteiler stumm: "ntfy oeffnen" faende die App
         nicht, und ein Link in den App-Laden liesse sich nicht oeffnen.

         BEWUSST NICHT QUERY_ALL_PACKAGES. Diese Berechtigung zeigt die
         gesamte Liste installierter Apps — bei Google ist sie
         genehmigungspflichtig, und fuer eine App, die Metadaten vermeidet,
         waere sie ein Selbstwiderspruch. Hier steht nur, was wirklich
         gebraucht wird: ntfy beim Namen, und Browser. -->
    <queries>
        <package android:name="io.heckel.ntfy"/>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>

    <!-- ══════════════════════════════════════════════════════════════════
         AUSDRUECKLICH ENTFERNT, was die Kamera-Bibliothek mitbringt.

         Das camera-Plugin traegt in sein Manifest RECORD_AUDIO und die
         Speicher-Berechtigungen ein, weil es auch Videos aufnehmen kann. BitDM
         nimmt nichts auf: der CameraController wird mit enableAudio: false
         erzeugt und liest nur Einzelbilder.

         Ohne diese Zeilen staende im Play Store bei einer App, die mit
         Vertraulichkeit wirbt, "kann Audio aufnehmen" und "kann auf Dateien
         zugreifen". Das zerstoert mehr Vertrauen, als jede Verschluesselung
         aufbauen kann — und es waere schlicht nicht wahr.

         Geprueft nach jedem Bauen mit:
             aapt2 dump permissions app-release.apk
         ══════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove"/>

    <!-- ACCESS_NETWORK_STATE bleibt: sie ist eine "normale" Berechtigung, die
         der Nutzer nie zu Gesicht bekommt, und sie wird gebraucht, um beim
         Wiederverbinden nicht ins Leere zu funken, wenn ohnehin kein Netz da
         ist. -->

    <application
        android:label="BitDM"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Haelt den Prozess am Leben, solange im Hintergrund empfangen
             werden soll. Der Dienst empfaengt NICHT selbst — das macht
             derselbe Dart-Code wie im Vordergrund. Siehe EmpfangsDienst.kt.

             dataSync als Typ: BitDM gleicht Nachrichten ab. "shortService"
             waere auf drei Minuten begrenzt, "connectedDevice" meint
             gekoppelte Geraete. -->
        <service
            android:name=".EmpfangsDienst"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
