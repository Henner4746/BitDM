[Unit]
Description=BitDM: Waechter fuer das Zwischenlager (Storage-VPS)
After=network-online.target

[Service]
Type=oneshot
# root, weil der Schluessel /root/.ssh/storage_transfer root gehoert und nur
# root den Storage-VPS erreicht. Dafuer eng eingezaeunt:
EnvironmentFile=/etc/bitdm/waechter.env
ExecStart=/usr/local/sbin/bitdm-storage-waechter
StateDirectory=bitdm-waechter
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
TimeoutStartSec=90
