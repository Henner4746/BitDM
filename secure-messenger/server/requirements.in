uvicorn==0.53.0
pydantic==2.13.5

# XEdDSA-Signaturpruefung ueber Curve25519-Identitaetsschluessel.
# Zwingend: libsignal signiert mit XEdDSA, nicht mit reinem Ed25519 —
# `cryptography` allein kann das nicht pruefen.
# Systemabhaengigkeit: libsodium (unter Linux ggf. `apt install libsodium23`).
